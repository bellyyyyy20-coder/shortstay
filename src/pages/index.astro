---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ShortStay - Direct bookings. No middleman fees.">
  <main class="min-h-screen">
    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <div class="text-center">
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-text-primary tracking-tight">
            Find your next short stay
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-text-secondary max-w-2xl mx-auto">
            Direct bookings. No middleman fees. Book with confidence and avoid double bookings.
          </p>
          <div class="mt-10 flex gap-4 justify-center">
            <a href="/listings" class="bg-primary text-primary-foreground px-6 py-3 rounded-md font-medium hover:bg-primary-hover transition-colors">
              Browse Listings
            </a>
            <a href="/host" class="bg-white text-text-primary border border-border px-6 py-3 rounded-md font-medium hover:bg-subtle-background transition-colors">
              List your property
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
