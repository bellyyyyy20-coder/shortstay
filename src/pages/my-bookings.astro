---
import Layout from '../layouts/Layout.astro';
---

<Layout title="My Bookings - ShortStay">
  <main class="min-h-screen bg-subtle-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-8">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-text-primary">My Bookings</h1>
        <p class="mt-2 text-text-secondary">View and manage your bookings</p>
      </div>
      
      <div class="bg-surface border border-border rounded-lg p-6 text-center py-12">
        <p class="text-text-secondary">No bookings yet</p>
        <a href="/listings" class="inline-block mt-4 text-primary hover:underline">Browse listings</a>
      </div>
    </div>
  </main>
</Layout>
